# Copy this file to .env and fill in your own values. Never commit or share .env.
GEMINI_API_KEY=
# Optional extra keys for rotation, comma-separated
GEMINI_API_KEYS=
# gemini (needs a key) or none (fully offline rules)
LLM_PROVIDER=none
GEMINI_MODEL=gemini-3.8-flash
# Optional shared secret for a public demo URL (?token=...)
DEMO_ACCESS_TOKEN=
# Cooling-off after a Guardian lock, in seconds (production: 3600)
DEMO_COOLING_OFF_SECONDS=60
# HOST=127.0.0.1
# PORT=8000
# Corporate proxy, only if your network needs one
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1
